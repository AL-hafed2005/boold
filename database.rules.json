{
  "rules": {
    "ibddmp_users": {
      ".read": "auth != null && root.child('ibddmp_users/'+auth.uid+'/role').val() === 'admin'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (root.child('ibddmp_users/'+auth.uid+'/role').val() === 'admin' || (auth.uid === $uid && !root.child('ibddmp_users').exists() && newData.child('role').val() === 'admin'))"
      }
    },
    "ibddmp": {
      ".read": "auth != null && root.child('ibddmp_users/'+auth.uid+'/role').exists()",
      ".write": "auth != null && root.child('ibddmp_users/'+auth.uid+'/role').val() === 'admin'",
      "inventory": {
        ".write": "auth != null && root.child('ibddmp_users/'+auth.uid+'/role').exists()"
      },
      "donors": {
        "$id": {
          ".write": "auth != null && ((newData.exists() && root.child('ibddmp_users/'+auth.uid+'/role').exists()) || (!newData.exists() && root.child('ibddmp_users/'+auth.uid+'/role').val() === 'admin'))"
        }
      },
      "log": {
        "$lid": {
          ".write": "auth != null && root.child('ibddmp_users/'+auth.uid+'/role').exists() && !data.exists()"
        }
      }
    }
  }
}
